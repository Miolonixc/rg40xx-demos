def wifi_power_save(state=None):
    """Return {interface: "on"/"off"} for Wi-Fi power save, setting it first when state is given.

    With power save on, the Realtek chip naps between beacons and packets wait up to ~200 ms."""
    try:
        out = subprocess.run(["iw", "dev"], capture_output=True, text=True).stdout
    except OSError:
        return {}
    result = {}
    for iface in (l.split()[1] for l in out.splitlines() if l.strip().startswith("Interface ")):
        want = state.get(iface) if isinstance(state, dict) else state
        if want:
            subprocess.run(["iw", "dev", iface, "set", "power_save", want], capture_output=True)
        res = subprocess.run(["iw", "dev", iface, "get", "power_save"], capture_output=True, text=True)
        if "Power save:" in res.stdout:
            result[iface] = res.stdout.split(":")[1].strip()
    return result


def _output(cmd):
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


# Settings in CONF: allowed values (first is the default) and whether a running cast picks them up
# at once (the handheld's own screen and sound) or has to be restarted (everything about the stream).
SETTINGS = {
    "screen": (("on", "off"), True),     # handheld screen while casting
    "sound": (("on", "off"), True),      # handheld speaker while casting
    "aspect": (("4:3", "stretch", "zoom"), False),
    "bitrate": (("3000", "2000", "5000"), False),  # kbit/s
    "delay": (("250", "150", "400"), False),       # receiver buffer, ms
    "fps": (("30", "25", "20"), False),
}


def settings():
    conf = read_conf()
    if conf.get("gamepad") == "on":  # older single switch for both
        conf.setdefault("screen", "off")
        conf.setdefault("sound", "off")
    return {key: conf.get(key) if conf.get(key) in values else values[0]
            for key, (values, _) in SETTINGS.items()}


class Handheld:
    """The handheld's own screen and speaker while casting, for using it as just a gamepad.

    The screen goes dark with the backlight at 0 (not Knulli's fb blank, which could hold up games
    waiting for vsync); the sound by muting the PipeWire output, which silences the speaker but not
    the monitor that is cast (switching LINEOUT off in the mixer breaks the capture instead)."""

    def __init__(self):
        self.brightness = self.mute = None  # saved values while switched off

    def apply(self, screen_on, sound_on):
        if not screen_on and self.brightness is None:
            self.brightness = _output(["brightness", "get"])
            _output(["brightness", "set", "0"])
            log("handheld screen off")
        elif screen_on and self.brightness is not None:
            if self.brightness.isdigit() and int(self.brightness) > 0:
                _output(["brightness", "set", self.brightness])
            self.brightness = None
            log("handheld screen back on")
        if not sound_on and self.mute is None:
            self.mute = _output(["pactl", "get-sink-mute", "@DEFAULT_SINK@"])
            _output(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "1"])
            log("handheld speaker muted")
        elif sound_on and self.mute is not None:
            if not self.mute.endswith("yes"):
                _output(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "0"])
            self.mute = None
            log("handheld speaker back on")


def read_state():
    try:
        state = json.load(open(STATE))
        os.kill(state["pid"], 0)
        return state
    except (OSError, ValueError, KeyError, TypeError):
        return None


def write_state(**state):
    with open(STATE + ".tmp", "w") as f:
        json.dump(dict(state, pid=os.getpid()), f)
    os.replace(STATE + ".tmp", STATE)


def cmd_list(raw=False):
    devices = discover()
    for name, model, ip in devices:
        print(("%s\t%s\t%s" if raw else "%-24s %-22s %s") % (name, model, ip))
    if not devices and not raw:
        print("no Chromecast devices found")


def cmd_start(target, opts, probe=False):
    if not probe:
        cmd_stop(quiet=True)
        # visible to "stop" (and a restart) already while connecting
        write_state(device=target or read_conf().get("device", ""), ip="", since=int(time.time()), connecting=True)
    conf = settings()
    for key in ("fps", "bitrate", "delay", "aspect"):
        if opts[key] is None:
            opts[key] = conf[key] if key == "aspect" else int(conf[key])
    name, ip = resolve(target)
    log("connecting to %s (%s)" % (name, ip))
    ch = CastChannel(ip)
    transport_id, session_id = launch_mirroring(ch)
    log("mirroring receiver started, session", session_id)
    media = Session(opts["fps"], opts["bitrate"], opts["delay"], audio=opts["audio"], aspect=opts["aspect"])
    handheld = Handheld()
    stopping, reload = threading.Event(), threading.Event()

    def shutdown(*_):
        stopping.set()

    signal.signal(signal.SIGTERM, shutdown)
    signal.signal(signal.SIGINT, shutdown)
    signal.signal(signal.SIGUSR1, lambda *_: reload.set())  # "cast-screen set screen|sound" while casting
    power_save = {}
    try:
        answer, streams = negotiate(ch, transport_id, media.streams)
        log("receiver answered:", json.dumps(answer))
        log("streaming %s: %d fps, %d kbit/s, %d ms delay, picture %s" % (
            " and ".join(s.kind for s in streams), opts["fps"], opts["bitrate"], opts["delay"], opts["aspect"]))
        if not probe:
            power_save = wifi_power_save()
            log("Wi-Fi power save off:", wifi_power_save("off"))
            media.start(ip, answer["udpPort"], streams)
            since = int(time.time())
            reload.set()
            while not (stopping.is_set() or ch.closed.is_set() or media.stop.is_set()):
                if reload.is_set():
                    reload.clear()
                    conf = settings()
                    handheld.apply(conf["screen"] == "on", conf["sound"] == "on")
                    write_state(device=name, ip=ip, since=since, **conf)
                stopping.wait(0.5)
    finally:
        handheld.apply(True, True)
        media.close()
        if power_save:
            wifi_power_save(power_save)
        if not ch.closed.is_set():
            try:
                ch.request(NS_RECEIVER, {"type": "STOP", "sessionId": session_id})
                time.sleep(0.3)
            except OSError:
                pass
        ch.close()
        state = read_state()
        if not probe and state and state["pid"] == os.getpid():
            os.remove(STATE)
        log("stopped")


def cmd_stop(quiet=False):
    state = read_state()
    if not state:
        if not quiet:
            print("cast-screen is not running")
        return
    os.kill(state["pid"], signal.SIGTERM)
    for _ in range(50):  # let it send STOP to the Chromecast and bring the screen back
        try:
            os.kill(state["pid"], 0)
        except OSError:
            break
        time.sleep(0.1)
    if not quiet:
        print("stopped casting to", state["device"])


def start_background(device):
    """Start casting detached from the caller (the app or a menu script), logging to LOG."""
    cmd_stop(quiet=True)  # before truncating the log the running cast still writes to
    with open(LOG, "w") as log_file:
        subprocess.Popen([sys.executable, os.path.abspath(__file__), "start", device], stdout=log_file,
                         stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)


def cmd_status(raw=False):
    state = read_state()
    conf = settings()
    if raw:
        print("casting=%d" % bool(state and not state.get("connecting")))
        if state:
            print("device=%s\nip=%s\nsince=%d" % (state["device"], state["ip"], state["since"]))
        print("default=%s" % read_conf().get("device", ""))
        print("".join("%s=%s\n" % kv for kv in conf.items()), end="")
    elif state and state.get("connecting"):
        print("connecting to", state["device"] or "the default Chromecast")
    elif state:
        print("casting to %s (%s) for %d s" % (state["device"], state["ip"], time.time() - state["since"]))
    else:
        print("not casting")
    if not raw:
        print("settings: " + ", ".join("%s=%s" % kv for kv in conf.items()))


def cmd_set(key, value):
    if key == "device" and value:
        write_conf(device=value)
        return
    if key not in SETTINGS or value not in SETTINGS[key][0]:
        sys.exit("usage: cast-screen set device NAME | " + " | ".join(
            "set %s %s" % (k, "|".join(v)) for k, (v, _) in SETTINGS.items()))
    write_conf(**{key: value})
    state = read_state()
    if not state:
        return
    if SETTINGS[key][1]:
        os.kill(state["pid"], signal.SIGUSR1)
    else:  # the stream itself changes: cast again to the same device
        cmd_stop(quiet=True)
        start_background(state["device"])
        print("restarting the cast to", state["device"])


def main(argv):
    global VERBOSE
    opts = {"delay": None, "bitrate": None, "fps": None, "aspect": None, "audio": True}
    args, raw = [], False
    it = iter(argv)
    for a in it:
        if a == "-v":
            VERBOSE = True
        elif a == "--raw":
            raw = True
        elif a == "--no-audio":
            opts["audio"] = False
        elif a in ("--delay", "--bitrate", "--fps"):
            opts[a[2:]] = int(next(it))
        elif a == "--aspect":
            opts["aspect"] = next(it)
        else:
            args.append(a)
    if not args:
        sys.exit(__doc__)
    command, target = args[0], (args[1] if len(args) > 1 else None)
    if command == "list":
        cmd_list(raw)
    elif command in ("start", "probe"):
        cmd_start(target, opts, probe=command == "probe")
    elif command == "background":
        start_background(target or read_conf().get("device", ""))
    elif command == "stop":
        cmd_stop()
    elif command == "status":
        cmd_status(raw)
    elif command == "set":
        cmd_set(target, " ".join(args[2:]) or None)
    else:
        sys.exit(__doc__)


if __name__ == "__main__":
    main(sys.argv[1:])
